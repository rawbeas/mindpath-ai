# Firebase Admin SDK — Firebase Console > Project Settings (gear icon) >
# Service accounts > Generate new private key. Save the downloaded json
# in this backend/ folder and point this at it.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Gemini — free, no credit card. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Sum of grief + fear + sadness above this triggers a counsellor alert + AI summary
RISK_THRESHOLD=0.7

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# ── Email alerts (optional) ───────────────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASSWORD empty to disable. The app works fully
# without email — counsellors just check the dashboard/alerts page instead.
#
# Gmail quick-start:
#   1. Enable 2-Step Verification on your Google account (if not already on)
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" — you get a 16-character code
#   4. Use your normal Gmail address as SMTP_USER
#   5. Use that 16-character code (without spaces) as SMTP_PASSWORD
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=False
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MindPath AI
