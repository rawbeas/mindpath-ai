# ─────────────────────────────────────────────────────────────────────────────
# MindPath AI — Frontend environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# HOW TO USE THIS FILE:
#   Copy it to .env.local (which is gitignored, so never committed):
#     Mac/Linux:  cp .env.local.example .env.local
#     Windows:    copy .env.local.example .env.local
#   Then fill in every value below with YOUR project's credentials.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Web App Config ───────────────────────────────────────────────────
# Where to find these values:
#   Firebase Console (https://console.firebase.google.com)
#     → your project → gear icon → Project settings
#     → General tab → scroll to "Your apps" → click your Web app
#     → copy each value from the firebaseConfig object shown there
#
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# ── Backend API URL ───────────────────────────────────────────────────────────
# For local development keep this as localhost:8000.
# If you deploy the backend to Render/Railway, replace with that URL, e.g.:
#   NEXT_PUBLIC_API_BASE_URL=https://mindpath-ai-backend.onrender.com
#
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
